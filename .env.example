# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Service role key: worker + seed only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Ollama (OpenAI-compatible API at $OLLAMA_BASE_URL/v1)
OLLAMA_BASE_URL=http://localhost:11434
SCORER_MODEL=gemma3:4b
DRAFTER_MODEL=gemma3:12b

# Search
SEARXNG_URL=http://localhost:8080
SERPAPI_KEY=your-serpapi-key

# Seed script: the account that owns the GlamVault project
SEED_USER_EMAIL=you@example.com
